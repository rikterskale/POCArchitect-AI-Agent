# MANIFEST.in - Controls which files go into (source distribution)

# Core files
include LICENSE
include README.md
include POCArchitect_Quickstart.txt
include .env.example
include requirements.txt
include requirements-dev.txt
include pytest.ini

# The critical prompt file (and any other package data)
include pocarchitect/POC_Architect_Prompt.md

# Recursively include any Markdown or data files inside the package
recursive-include pocarchitect *.md
recursive-include pocarchitect *.txt
recursive-include docs *.md
recursive-include docs *.py
recursive-include example_usage *.md
recursive-include example_usage *.txt
recursive-include scripts *.py
include verify.sh
include test-full.sh

# Exclude tests and repository-only automation from the distribution
prune tests
prune .github
prune .pytest_cache
prune .ruff_cache
prune .mypy_cache
