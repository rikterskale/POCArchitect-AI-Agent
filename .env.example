# POCArchitect AI Agent - Environment Variables
# Copy this file to .env and fill in your key(s)

# Add only the credential for the cloud provider you will use. These placeholders
# are intentionally rejected by preflight; replace one of them in a local .env file.

# xAI / Grok
XAI_API_KEY=your_key_here

# OpenAI
OPENAI_API_KEY=your_key_here

# Groq
GROQ_API_KEY=your_key_here
